f = open("marks.txt" , "r")
i =0 #for lines
while True:
    i = i+1
    lines =(f.readline())

    if not lines:
        break
    m1 = int(lines.split(",")[0])
    m2 = int(lines.split(",")[1])
    m3 = int(lines.split(",")[2])
    
    print(f"Marks of Student {i} in maths is : {m1}")
    print(f"Marks of Student {i} in english is : {m2}")
    print(f"Marks of Student {i} in msst is : {m3}")
 
    print(lines)